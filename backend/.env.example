# DCCheck backend – environment variable reference
# Copy this file to .env and fill in the values for your environment.
# Never commit .env to version control.

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# AsyncPG connection URL used by SQLAlchemy and Alembic.
DATABASE_URL=postgresql+asyncpg://postgres:postgres@db:5432/dccheck

# ---------------------------------------------------------------------------
# JWT / Security
# ---------------------------------------------------------------------------
# Long, random secret used to sign JWT tokens.
# Generate a suitable value with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-long-random-secret-key

# Access token lifetime in minutes.
ACCESS_TOKEN_MINUTES=60

# Refresh token lifetime in days.
REFRESH_TOKEN_DAYS=7

# ---------------------------------------------------------------------------
# File storage
# ---------------------------------------------------------------------------
# Absolute path (inside the container) where uploaded photos are stored.
STORAGE_PATH=/app/storage/fotos

# ---------------------------------------------------------------------------
# CORS
# ---------------------------------------------------------------------------
# Comma-separated list of allowed origins for the frontend.
ALLOWED_ORIGINS=http://dccheck.smart.intranet,http://localhost:3000

# ---------------------------------------------------------------------------
# SMTP / Email
# ---------------------------------------------------------------------------
SMTP_HOST=smtp.smart.intranet
SMTP_PORT=587
SMTP_USER=dccheck@smart.intranet
SMTP_PASSWORD=your-smtp-password-here
SMTP_FROM=noreply@smart.intranet

# ---------------------------------------------------------------------------
# Notifications
# ---------------------------------------------------------------------------
# Email address of the datacenter manager that receives failure alerts.
GESTOR_EMAIL=gestor@smart.intranet

# ---------------------------------------------------------------------------
# Password reset
# ---------------------------------------------------------------------------
# Lifetime of a password-reset token in minutes (default: 30).
RESET_TOKEN_MINUTES=30
